# 배포 서버(Render 등)의 "환경 변수" 화면에만 넣습니다. 이 파일에 진짜 값을 적지 마세요.
# 비워 두면 로컬에서 ./.data/pglite 파일 데이터베이스를 씁니다.
# Supabase 를 Vercel 에 연결하면 POSTGRES_URL 이 자동으로 들어오므로 보통은 비워 둡니다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
PORT=3000

# (7번) 6번 때 로그인 없이 넣어 둔 자료를 가져갈 내 이메일. 이 이메일로 처음 가입할 때 한 번만 옮겨진다.
OWNER_EMAIL=me@example.com
