{
  "$comment": "PDS 플래너 최종 데이터베이스 계약. 실제 표는 server/schema.js 의 SQL 이 만들며, 이 파일과 내용이 같아야 한다.",
  "name": "pds-schema",
  "version": 2,
  "database": "PostgreSQL 16 (배포: Vercel + Supabase PostgreSQL (POSTGRES_URL 또는 DATABASE_URL) / 로컬·테스트: PGlite)",
  "rules": {
    "ids": "모든 ID는 서버가 만드는 UUID v4. 화면이 ID를 만들지 않는다.",
    "date": "기간·마감일 같은 '날짜'는 PostgreSQL date 로 저장하고 API에서는 시간대 없는 'YYYY-MM-DD' 문자열로 주고받는다. JavaScript Date 로 바꾸지 않아 하루 밀림이 없다.",
    "instant": "시작·끝·저장 시각 같은 '순간'은 timestamptz 로 저장하고 API에서는 ISO 8601 UTC 문자열('2026-11-02T00:00:00.000Z')로 돌려준다. 받을 때는 시간대가 붙은 ISO 8601만 받는다(화면은 서울 시각에 '+09:00'을 붙여 보낸다).",
    "time_zone": "'오늘'은 서버 시간대와 상관없이 항상 Asia/Seoul 달력 날짜로 계산한다. 화면의 시각 표시도 Asia/Seoul.",
    "units": "예상 시간·실제 시간은 모두 '분' 단위 정수(0 이상).",
    "priority": "1 = 높음, 2 = 보통, 3 = 낮음. 숫자가 작을수록 먼저.",
    "soft_delete": "할 일을 지우면 deleted_at 에 시각만 적는다. 목록·검색·돌아보기 집계에서 모두 빠진다.",
    "history": "계획을 고치면 고치기 전 행 전체를 plan_versions 에 먼저 복사한 뒤 plans 를 고치고 version 을 1 올린다. plan_versions 는 고치거나 지우지 않는다.",
    "row_level_security": "모든 표에 RLS 를 켜고 정책은 두지 않는다. Supabase REST API(anon/authenticated)로는 접근할 수 없고, 표 주인인 서버만 읽고 쓴다.",
    "separation": "실행 기록(work_logs)은 계획·할 일의 예상값을 고치지 않는다. 실제 시간은 실행 기록에만 있다."
  },
  "tables": {
    "plans": {
      "description": "계획 (Plan)",
      "columns": {
        "id": { "type": "uuid", "pk": true },
        "title": { "type": "text", "required": true, "check": "1~200자" },
        "start_date": { "type": "date", "required": true, "format": "YYYY-MM-DD", "note": "기간 시작" },
        "end_date": { "type": "date", "required": true, "format": "YYYY-MM-DD", "check": "end_date >= start_date" },
        "priority": { "type": "smallint", "required": true, "check": "1~3" },
        "success_criteria": { "type": "text", "required": true, "check": "1~2000자" },
        "estimate_minutes": { "type": "integer", "required": true, "unit": "minute", "check": ">= 0" },
        "carried_review_id": { "type": "uuid", "nullable": true, "fk": "reviews.id", "on_delete": "SET NULL", "note": "지난 돌아보기에서 넘겨받은 고칠 점 한 건" },
        "version": { "type": "integer", "default": 1, "note": "고칠 때마다 1 증가" },
        "created_at": { "type": "timestamptz", "default": "now()" },
        "updated_at": { "type": "timestamptz", "default": "now()" }
      }
    },
    "plan_versions": {
      "description": "고치기 전 계획 (덮어쓰지 않는 이력)",
      "columns": {
        "id": { "type": "uuid", "pk": true },
        "plan_id": { "type": "uuid", "fk": "plans.id", "on_delete": "CASCADE" },
        "version": { "type": "integer", "note": "고치기 전 버전 번호" },
        "title": { "type": "text" },
        "start_date": { "type": "date", "format": "YYYY-MM-DD" },
        "end_date": { "type": "date", "format": "YYYY-MM-DD" },
        "priority": { "type": "smallint" },
        "success_criteria": { "type": "text" },
        "estimate_minutes": { "type": "integer", "unit": "minute" },
        "saved_at": { "type": "timestamptz", "note": "이 버전이 다음 버전으로 바뀐 시각" }
      },
      "unique": [["plan_id", "version"]]
    },
    "tasks": {
      "description": "할 일 (Do)",
      "columns": {
        "id": { "type": "uuid", "pk": true },
        "plan_id": { "type": "uuid", "fk": "plans.id", "on_delete": "CASCADE", "required": true },
        "title": { "type": "text", "required": true, "check": "1~300자" },
        "status": { "type": "text", "enum": ["in_progress", "done"], "default": "in_progress" },
        "due_date": { "type": "date", "nullable": true, "format": "YYYY-MM-DD", "note": "화면에서는 필수로 입력" },
        "priority": { "type": "smallint", "nullable": true, "check": "1~3" },
        "tags": { "type": "jsonb", "default": "[]", "note": "문자열 배열, 각 30자 이하, 최대 10개, 중복 없음" },
        "estimate_minutes": { "type": "integer", "nullable": true, "unit": "minute", "check": ">= 0" },
        "completed_at": { "type": "timestamptz", "nullable": true },
        "deleted_at": { "type": "timestamptz", "nullable": true, "note": "값이 있으면 지운 할 일" },
        "created_at": { "type": "timestamptz", "default": "now()" },
        "updated_at": { "type": "timestamptz", "default": "now()" }
      }
    },
    "task_completions": {
      "description": "완료 기록. 되돌리지 않은 완료는 할 일당 한 건",
      "columns": {
        "id": { "type": "uuid", "pk": true },
        "task_id": { "type": "uuid", "fk": "tasks.id", "on_delete": "CASCADE" },
        "completed_at": { "type": "timestamptz", "default": "now()" },
        "reopened_at": { "type": "timestamptz", "nullable": true, "note": "진행 중으로 되돌린 시각" }
      },
      "unique_partial": [{ "columns": ["task_id"], "where": "reopened_at IS NULL" }],
      "idempotency": "완료 API는 status <> 'done' 인 행만 바꾸고, 바뀐 경우에만 기록을 넣는다. 부분 유일 인덱스가 동시 요청도 막는다."
    },
    "work_logs": {
      "description": "실행 기록",
      "columns": {
        "id": { "type": "uuid", "pk": true },
        "task_id": { "type": "uuid", "fk": "tasks.id", "on_delete": "CASCADE" },
        "started_at": { "type": "timestamptz", "required": true },
        "ended_at": { "type": "timestamptz", "required": true, "check": "ended_at >= started_at" },
        "actual_minutes": { "type": "integer", "required": true, "unit": "minute", "note": "비워 보내면 끝−시작(분, 반올림)" },
        "blocked_reason": { "type": "text", "nullable": true, "note": "공백만 있으면 null 로 저장" },
        "note": { "type": "text", "nullable": true },
        "created_at": { "type": "timestamptz", "default": "now()" }
      }
    },
    "reviews": {
      "description": "돌아보기 (See)",
      "columns": {
        "id": { "type": "uuid", "pk": true },
        "plan_id": { "type": "uuid", "fk": "plans.id", "on_delete": "CASCADE" },
        "improvement": { "type": "text", "required": true, "check": "1~1000자", "note": "다음 계획으로 넘길 고칠 점 한 건" },
        "summary": { "type": "jsonb", "note": "저장 시점의 집계(아래 review_metrics)" },
        "created_at": { "type": "timestamptz", "default": "now()" }
      }
    }
  },
  "relations": [
    { "from": "plan_versions.plan_id", "to": "plans.id", "kind": "many-to-one" },
    { "from": "tasks.plan_id", "to": "plans.id", "kind": "many-to-one" },
    { "from": "task_completions.task_id", "to": "tasks.id", "kind": "many-to-one" },
    { "from": "work_logs.task_id", "to": "tasks.id", "kind": "many-to-one" },
    { "from": "reviews.plan_id", "to": "plans.id", "kind": "many-to-one" },
    { "from": "plans.carried_review_id", "to": "reviews.id", "kind": "many-to-one (optional)" }
  ],
  "review_metrics": {
    "target_tasks": "plan_id 가 그 계획이고 deleted_at IS NULL 인 할 일",
    "planned": "대상 할 일 수",
    "completed": "대상 중 status = 'done' 인 수",
    "overdue": "대상 중 status <> 'done' AND due_date IS NOT NULL AND due_date < 오늘(Asia/Seoul) 인 수. 완료한 할 일은 세지 않는다.",
    "blocked": "대상 중 blocked_reason 이 비어 있지 않은 실행 기록이 하나라도 있는 할 일 수 (기록 수가 아님)",
    "estimate_minutes": "대상 할 일 estimate_minutes 합계, 없으면 0",
    "actual_minutes": "대상 할 일의 work_logs.actual_minutes 합계, 없으면 0",
    "diff_minutes": "actual_minutes − estimate_minutes",
    "drilldown": "API는 각 숫자를 만든 할 일 ID(ids.planned/completed/overdue/blocked)와 실행 기록 ID(ids.logs)를 함께 돌려주고, 화면은 숫자를 누르면 그 기록만 보여 준다."
  },
  "export": {
    "endpoint": "GET /api/export",
    "file": "pds-export-YYYY-MM-DD.json (날짜는 서울 기준)",
    "contains": ["plans", "plan_versions", "tasks", "task_completions", "work_logs", "reviews"]
  }
}
